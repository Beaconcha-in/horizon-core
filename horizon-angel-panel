<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>افق فرشته · مرکز فرماندهی جهانی</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family:'Inter', sans-serif;
            background: #0a0f1e;
            color:#eef2ff;
            overflow:hidden;
            height:100vh;
            width:100vw;
        }
        .main-container {
            display:flex;
            height:100vh;
            width:100vw;
            position:relative;
        }
        /* ===== نقشه ===== */
        #map {
            flex:1;
            height:100%;
            width:100%;
            z-index:1;
            background: #0a0f1e;
        }
        .leaflet-control-zoom { display:none; }
        .leaflet-tile-pane { filter: grayscale(0.3) brightness(0.6) contrast(1.2); }

        /* ===== هدر شناور ===== */
        .floating-header {
            position:fixed;
            top:1.2rem;
            left:50%;
            transform:translateX(-50%);
            z-index:1000;
            background:rgba(10,15,30,0.85);
            backdrop-filter:blur(16px);
            border-radius:3rem;
            border:1px solid rgba(79,158,255,0.2);
            padding:0.6rem 1.8rem;
            display:flex;
            align-items:center;
            gap:1.5rem;
            flex-wrap:wrap;
            justify-content:center;
            box-shadow:0 8px 40px rgba(0,0,0,0.6);
            pointer-events:auto;
        }
        .floating-header .title {
            font-size:1.1rem;
            font-weight:800;
            background:linear-gradient(135deg,#fff,#4f9eff,#c084fc);
            -webkit-background-clip:text;
            background-clip:text;
            color:transparent;
            white-space:nowrap;
        }
        .floating-header .badge-group {
            display:flex;
            gap:0.5rem;
            flex-wrap:wrap;
        }
        .floating-header .badge {
            background:rgba(79,158,255,0.12);
            border:1px solid #4f9eff33;
            padding:0.1rem 0.8rem;
            border-radius:60px;
            font-size:0.55rem;
            color:#9bb2ff;
            white-space:nowrap;
        }
        .floating-header .badge.green { background:rgba(74,222,128,0.12); border-color:#4ade8044; color:#4ade80; }
        .floating-header .badge.red { background:rgba(248,113,113,0.12); border-color:#f8717144; color:#f87171; }
        .floating-header .badge.blue { background:rgba(79,158,255,0.12); border-color:#4f9eff44; color:#4f9eff; }
        .floating-header .badge.gold { background:rgba(251,191,36,0.12); border-color:#facc1544; color:#facc15; }

        /* ===== پنل کناری ===== */
        .side-panel {
            position:fixed;
            right:0;
            top:0;
            height:100%;
            width:340px;
            background:rgba(10,15,30,0.92);
            backdrop-filter:blur(20px);
            border-left:1px solid rgba(79,158,255,0.15);
            z-index:500;
            padding:1.5rem 1.2rem;
            overflow-y:auto;
            transform:translateX(0);
            transition:0.4s cubic-bezier(0.4,0,0.2,1);
            pointer-events:auto;
        }
        .side-panel.closed { transform:translateX(340px); }
        .side-panel .toggle-btn {
            position:absolute;
            left:-40px;
            top:50%;
            transform:translateY(-50%);
            background:rgba(10,15,30,0.9);
            border:1px solid rgba(79,158,255,0.2);
            border-right:none;
            border-radius:1rem 0 0 1rem;
            padding:0.6rem 0.8rem;
            color:#4f9eff;
            cursor:pointer;
            font-size:1.2rem;
            backdrop-filter:blur(8px);
        }
        .side-panel h2 {
            font-size:0.9rem;
            font-weight:700;
            margin-bottom:0.8rem;
            color:#4f9eff;
            border-bottom:1px solid #1e2a44;
            padding-bottom:0.4rem;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
        .side-panel .stat-row {
            display:flex;
            justify-content:space-between;
            padding:0.3rem 0;
            border-bottom:1px solid #1a2238;
            font-size:0.7rem;
        }
        .side-panel .stat-row .label { color:#8fa2dc; }
        .side-panel .stat-row .value { font-weight:600; color:#eef2ff; }
        .side-panel .stat-row .value.green { color:#4ade80; }
        .side-panel .stat-row .value.red { color:#f87171; }
        .side-panel .stat-row .value.blue { color:#4f9eff; }
        .side-panel .stat-row .value.gold { color:#facc15; }

        .agent-item {
            background:rgba(20,24,36,0.5);
            border-radius:0.8rem;
            padding:0.4rem 0.8rem;
            margin-bottom:0.3rem;
            border-left:3px solid #4f9eff;
            font-size:0.65rem;
            display:flex;
            justify-content:space-between;
            align-items:center;
            cursor:pointer;
            transition:0.2s;
        }
        .agent-item:hover { background:rgba(79,158,255,0.1); }
        .agent-item .status-dot {
            width:8px;
            height:8px;
            border-radius:50%;
            display:inline-block;
            margin-left:0.3rem;
        }
        .agent-item .status-dot.online { background:#4ade80; }
        .agent-item .status-dot.offline { background:#f87171; }
        .agent-item .status-dot.idle { background:#facc15; }

        .emergency-btn {
            background:rgba(248,113,113,0.15);
            border:1px solid #f8717155;
            border-radius:2rem;
            padding:0.4rem 1rem;
            color:#f87171;
            font-size:0.6rem;
            font-weight:600;
            cursor:pointer;
            transition:0.3s;
            width:100%;
            text-align:center;
            margin-top:0.5rem;
        }
        .emergency-btn:hover { background:rgba(248,113,113,0.25); }

        /* ===== پاپ‌آپ اطلاعات عامل ===== */
        .agent-popup {
            position:fixed;
            top:50%;
            left:50%;
            transform:translate(-50%,-50%) scale(0.9);
            z-index:2000;
            background:rgba(10,15,30,0.96);
            backdrop-filter:blur(24px);
            border-radius:2rem;
            border:1px solid rgba(79,158,255,0.3);
            padding:2rem;
            max-width:500px;
            width:90%;
            opacity:0;
            pointer-events:none;
            transition:0.3s cubic-bezier(0.4,0,0.2,1);
            box-shadow:0 24px 80px rgba(0,0,0,0.8);
        }
        .agent-popup.open {
            opacity:1;
            pointer-events:auto;
            transform:translate(-50%,-50%) scale(1);
        }
        .agent-popup .close-btn {
            position:absolute;
            top:0.8rem;
            right:1.2rem;
            background:none;
            border:none;
            color:#8fa2dc;
            font-size:1.4rem;
            cursor:pointer;
        }
        .agent-popup h3 { font-size:1.2rem; margin-bottom:0.5rem; color:#4f9eff; }
        .agent-popup .detail-row {
            display:flex;
            justify-content:space-between;
            padding:0.2rem 0;
            font-size:0.8rem;
            border-bottom:1px solid #1a2238;
        }
        .agent-popup .detail-row .label { color:#8fa2dc; }
        .agent-popup .detail-row .value { color:#eef2ff; }

        /* ===== ویرایشگر پنل ===== */
        .panel-editor {
            position:fixed;
            bottom:2rem;
            right:1rem;
            z-index:3000;
        }
        .panel-editor button {
            background:rgba(79,158,255,0.15);
            border:1px solid #4f9eff44;
            border-radius:2rem;
            padding:0.4rem 1.2rem;
            color:#4f9eff;
            font-size:0.6rem;
            cursor:pointer;
            backdrop-filter:blur(8px);
            transition:0.3s;
        }
        .panel-editor button:hover { background:rgba(79,158,255,0.25); }

        /* ===== اسکرول ===== */
        ::-webkit-scrollbar { width:4px; }
        ::-webkit-scrollbar-track { background:#0f172a; }
        ::-webkit-scrollbar-thumb { background:#4f9eff; border-radius:4px; }

        @media (max-width:768px) {
            .side-panel { width:280px; }
            .side-panel.closed { transform:translateX(280px); }
            .floating-header { padding:0.4rem 1rem; gap:0.8rem; top:0.6rem; }
            .floating-header .title { font-size:0.9rem; }
            .floating-header .badge { font-size:0.45rem; padding:0.05rem 0.5rem; }
        }
    </style>
</head>
<body>

<div class="main-container">
    <!-- ===== نقشه ===== -->
    <div id="map"></div>

    <!-- ===== هدر شناور ===== -->
    <div class="floating-header">
        <span class="title">🌍 Horizon Command Center · مشهد</span>
        <div class="badge-group">
            <span class="badge green"><i class="fas fa-circle"></i> محصولات فعال: <span id="activeProductsCount">۱۲</span></span>
            <span class="badge red"><i class="fas fa-circle"></i> نودها: <span id="nodesCount">۲۴</span></span>
            <span class="badge blue"><i class="fas fa-circle"></i> عامل‌ها: <span id="agentsCount">۲۳۰</span></span>
            <span class="badge gold"><i class="fas fa-circle"></i> آنلاین: <span id="onlineCount">۱۸۶</span></span>
        </div>
        <button id="emergencyToggle" style="background:none;border:1px solid #f8717155;border-radius:2rem;padding:0.1rem 0.8rem;color:#f87171;font-size:0.55rem;cursor:pointer;">🔴 خاموش</button>
    </div>

    <!-- ===== پنل کناری ===== -->
    <div class="side-panel" id="sidePanel">
        <button class="toggle-btn" id="toggleSidePanel"><i class="fas fa-chevron-left"></i></button>
        <h2><i class="fas fa-chart-simple"></i> وضعیت لحظه‌ای</h2>
        <div class="stat-row"><span class="label">ولیدیتورها</span><span class="value blue" id="statValidators">۱۰۰,۰۰۰+</span></div>
        <div class="stat-row"><span class="label">آنلاین</span><span class="value green" id="statOnline">۸۸,۲۴۰</span></div>
        <div class="stat-row"><span class="label">آفلاین</span><span class="value red" id="statOffline">۱۱,۷۶۰</span></div>
        <div class="stat-row"><span class="label">لایسنس صادرشده</span><span class="value gold" id="statLicenses">۴۵۶</span></div>
        <div class="stat-row"><span class="label">تراکنش‌ها (۲۴h)</span><span class="value blue" id="statTx">۱۲,۴۵۶</span></div>
        <div class="stat-row"><span class="label">مخازن</span><span class="value" id="statRepos">۶</span></div>
        <div class="stat-row"><span class="label">کلید API اعتبار</span><span class="value green" id="statApiCredit">۱۰۰%</span></div>

        <h2 style="margin-top:1rem;"><i class="fas fa-robot"></i> عامل‌های فعال</h2>
        <div id="agentList"></div>

        <button class="emergency-btn" id="emergencyBtn"><i class="fas fa-power-off"></i> خاموش‌سازی اضطراری</button>
        <div style="margin-top:0.3rem;display:flex;gap:0.3rem;">
            <input type="password" id="shutdownPassword" placeholder="رمز خاموش‌سازی..." style="flex:1;background:#0f172a;border:1px solid #2a3a5a;border-radius:2rem;padding:0.2rem 0.8rem;color:#eef2ff;font-size:0.6rem;outline:none;" />
            <button id="shutdownConfirmBtn" style="background:#f87171;border:none;border-radius:2rem;padding:0.2rem 1rem;color:#0a0f1e;font-size:0.6rem;font-weight:700;cursor:pointer;">تأیید</button>
        </div>
    </div>

    <!-- ===== پاپ‌آپ عامل ===== -->
    <div class="agent-popup" id="agentPopup">
        <button class="close-btn" id="closePopup"><i class="fas fa-times"></i></button>
        <h3 id="popupName">عامل</h3>
        <div class="detail-row"><span class="label">وضعیت</span><span class="value" id="popupStatus">🟢 آنلاین</span></div>
        <div class="detail-row"><span class="label">مخزن</span><span class="value" id="popupRepo">—</span></div>
        <div class="detail-row"><span class="label">فایل در حال کار</span><span class="value" id="popupFile">—</span></div>
        <div class="detail-row"><span class="label">آخرین فعالیت</span><span class="value" id="popupLastActive">—</span></div>
        <div class="detail-row"><span class="label">تخصص</span><span class="value" id="popupSpecialty">—</span></div>
        <button id="popupActionBtn" style="margin-top:0.8rem;background:#4f9eff;border:none;border-radius:2rem;padding:0.3rem 1.5rem;color:#0a0f1e;font-weight:700;cursor:pointer;width:100%;">مدیریت عامل</button>
    </div>

    <!-- ===== ویرایشگر پنل ===== -->
    <div class="panel-editor">
        <button id="editPanelBtn"><i class="fas fa-pen"></i> ویرایش پنل</button>
    </div>
</div>

<script>
// =============================================================
// CONFIGURATION
// =============================================================
const MASHHAD_COORDS = [36.2605, 59.6168];
const AGENTS_REPO = 'https://raw.githubusercontent.com/beaconchain-horizon/agency-agents/main';
const GITHUB_ORG = 'beaconchain-horizon';
const GITHUB_TOKEN = 'your_github_token_here'; // از Secrets گیت‌هاب خوانده شود

// =============================================================
// AGENTS DATA (واقعی از مخزن agency-agents)
// =============================================================
const agentsList = [
    { id: 'frontend-developer', name: '🎨 Frontend Developer', specialty: 'React/Vue/UI', repo: 'hub', file: 'index.html' },
    { id: 'backend-architect', name: '🏗️ Backend Architect', specialty: 'Go/API/DB', repo: 'horizon-core-engine', file: 'main.go' },
    { id: 'security-engineer', name: '🔒 Security Engineer', specialty: 'Audit/Crypto', repo: 'verified-merkle-lib', file: 'tree.go' },
    { id: 'growth-hacker', name: '🚀 Growth Hacker', specialty: 'Marketing/Acquisition', repo: 'hub', file: 'README.md' },
    { id: 'ux-designer', name: '🎯 UX Designer', specialty: 'Design/UI/UX', repo: 'horizon-angel-panel', file: 'index.html' },
    { id: 'solidity-engineer', name: '⛓️ Solidity Engineer', specialty: 'Smart Contracts', repo: 'horizon-core-engine', file: 'contract.sol' },
    { id: 'data-analyst', name: '📊 Data Analyst', specialty: 'Analytics/BI', repo: 'Beaconchain.us', file: 'data.js' },
    { id: 'devops-automator', name: '⚙️ DevOps', specialty: 'CI/CD/Infra', repo: 'horizon-core-engine', file: 'deploy.yml' },
    { id: 'technical-writer', name: '📝 Tech Writer', specialty: 'Docs/Content', repo: 'hub', file: 'README.md' },
    { id: 'ai-engineer', name: '🤖 AI Engineer', specialty: 'ML/LLM', repo: 'agency-agents', file: 'agents.md' },
];

// =============================================================
// STATE
// =============================================================
let agents = [];
let map;
let markers = [];
let popupOpen = false;
let shutdownPassword = 'horizon2026'; // رمز پیش‌فرض

// =============================================================
// INIT MAP
// =============================================================
function initMap() {
    map = L.map('map', {
        center: MASHHAD_COORDS,
        zoom: 12,
        zoomControl: false,
        attributionControl: false,
        fadeAnimation: true,
        zoomAnimation: true,
    });

    // لایه نقشه (با تم تیره)
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap & CartoDB',
        subdomains: 'abcd',
        maxZoom: 19,
    }).addTo(map);

    // ===== نقاط روی نقشه =====
    // نقاط سبز (محصولات فعال)
    const productPoints = [
        { lat: 36.2705, lng: 59.6168, name: 'Horizon Wallet', type: 'product' },
        { lat: 36.2505, lng: 59.6268, name: 'Horizon Dashboard', type: 'product' },
        { lat: 36.2805, lng: 59.6068, name: 'Horizon Node', type: 'product' },
        { lat: 36.2405, lng: 59.6368, name: 'Validator License', type: 'product' },
        { lat: 36.2905, lng: 59.5968, name: 'Horizon Store', type: 'product' },
    ];
    productPoints.forEach(p => {
        const marker = L.circleMarker([p.lat, p.lng], {
            radius: 8,
            color: '#4ade80',
            fillColor: '#4ade80',
            fillOpacity: 0.8,
            weight: 2,
        }).addTo(map);
        marker.bindPopup(`<div style="color:#eef2ff;font-size:0.8rem;"><strong>🟢 ${p.name}</strong><br>محصول فعال</div>`);
        markers.push(marker);
    });

    // نقاط قرمز (نودها/ولیدیتورها)
    const nodePoints = [
        { lat: 36.2605, lng: 59.6068, name: 'Validator #1' },
        { lat: 36.2555, lng: 59.6268, name: 'Validator #2' },
        { lat: 36.2655, lng: 59.6368, name: 'Validator #3' },
        { lat: 36.2755, lng: 59.6168, name: 'Validator #4' },
        { lat: 36.2455, lng: 59.6068, name: 'Validator #5' },
        { lat: 36.2855, lng: 59.6268, name: 'Validator #6' },
    ];
    nodePoints.forEach(p => {
        const marker = L.circleMarker([p.lat, p.lng], {
            radius: 6,
            color: '#f87171',
            fillColor: '#f87171',
            fillOpacity: 0.8,
            weight: 2,
        }).addTo(map);
        marker.bindPopup(`<div style="color:#eef2ff;font-size:0.8rem;"><strong>🔴 ${p.name}</strong><br>نود فعال</div>`);
        markers.push(marker);
    });

    // نقاط آبی (عامل‌های AI)
    const agentPoints = [
        { lat: 36.2625, lng: 59.6128, name: 'Frontend Developer' },
        { lat: 36.2585, lng: 59.6208, name: 'Backend Architect' },
        { lat: 36.2645, lng: 59.6088, name: 'Security Engineer' },
        { lat: 36.2565, lng: 59.6188, name: 'Growth Hacker' },
        { lat: 36.2685, lng: 59.6148, name: 'UX Designer' },
        { lat: 36.2525, lng: 59.6228, name: 'Solidity Engineer' },
        { lat: 36.2665, lng: 59.6008, name: 'Data Analyst' },
        { lat: 36.2545, lng: 59.6308, name: 'DevOps' },
        { lat: 36.2725, lng: 59.6108, name: 'Tech Writer' },
        { lat: 36.2485, lng: 59.6288, name: 'AI Engineer' },
    ];
    agentPoints.forEach((p, i) => {
        const agent = agentsList[i] || { name: p.name, specialty: 'AI Agent' };
        const marker = L.circleMarker([p.lat, p.lng], {
            radius: 10,
            color: '#4f9eff',
            fillColor: '#4f9eff',
            fillOpacity: 0.7,
            weight: 2,
            className: 'agent-marker',
        }).addTo(map);
        marker.bindPopup(`<div style="color:#eef2ff;font-size:0.7rem;text-align:center;">
            <strong>🤖 ${agent.name}</strong><br>
            <span style="color:#8fa2dc;">${agent.specialty}</span><br>
            <button onclick="openAgentPopup('${agent.id}')" style="background:#4f9eff;border:none;border-radius:2rem;padding:0.2rem 1rem;color:#0a0f1e;font-weight:600;cursor:pointer;margin-top:0.2rem;font-size:0.6rem;">اطلاعات</button>
        </div>`);
        markers.push(marker);
    });

    // ===== خطوط شبکه (نماد اتصالات) =====
    const lineCoords = [
        [[36.2605, 59.6168], [36.2625, 59.6128]],
        [[36.2605, 59.6168], [36.2585, 59.6208]],
        [[36.2625, 59.6128], [36.2645, 59.6088]],
        [[36.2585, 59.6208], [36.2565, 59.6188]],
        [[36.2625, 59.6128], [36.2685, 59.6148]],
        [[36.2585, 59.6208], [36.2525, 59.6228]],
    ];
    lineCoords.forEach(coords => {
        L.polyline(coords, {
            color: '#4f9eff',
            weight: 0.5,
            opacity: 0.15,
            dashArray: '4 8',
        }).addTo(map);
    });

    // ===== مرکز فرماندهی (مشهد) =====
    L.marker(MASHHAD_COORDS, {
        icon: L.divIcon({
            className: 'custom-div-icon',
            html: `<div style="background:rgba(79,158,255,0.2);border-radius:50%;width:60px;height:60px;display:flex;align-items:center;justify-content:center;border:2px solid #4f9eff;box-shadow:0 0 40px rgba(79,158,255,0.3);"><i class="fas fa-flag" style="color:#4f9eff;font-size:1.8rem;"></i></div>`,
            iconSize: [60, 60],
            iconAnchor: [30, 30],
        })
    }).addTo(map).bindPopup(`<div style="color:#eef2ff;text-align:center;"><strong>🏛️ مرکز فرماندهی Horizon</strong><br>مشهد، ایران</div>`);
}

// =============================================================
// AGENT POPUP (واقعی)
// =============================================================
window.openAgentPopup = function(agentId) {
    const agent = agentsList.find(a => a.id === agentId) || agentsList[0];
    document.getElementById('popupName').textContent = agent.name;
    document.getElementById('popupStatus').innerHTML = `<span style="color:#4ade80;">🟢 آنلاین</span>`;
    document.getElementById('popupRepo').textContent = agent.repo || '—';
    document.getElementById('popupFile').textContent = agent.file || '—';
    document.getElementById('popupLastActive').textContent = new Date().toLocaleTimeString('fa-IR');
    document.getElementById('popupSpecialty').textContent = agent.specialty || '—';
    document.getElementById('agentPopup').classList.add('open');
    popupOpen = true;
};
document.getElementById('closePopup').addEventListener('click', () => {
    document.getElementById('agentPopup').classList.remove('open');
    popupOpen = false;
});
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popupOpen) {
        document.getElementById('agentPopup').classList.remove('open');
        popupOpen = false;
    }
});

// =============================================================
// SIDE PANEL AGENT LIST
// =============================================================
function renderAgentList() {
    const container = document.getElementById('agentList');
    container.innerHTML = agentsList.map(agent => `
        <div class="agent-item" onclick="openAgentPopup('${agent.id}')">
            <span>${agent.name}</span>
            <span>
                <span class="status-dot online"></span>
                <span style="font-size:0.55rem;color:#8fa2dc;">${agent.specialty}</span>
            </span>
        </div>
    `).join('');
}
renderAgentList();

// =============================================================
// EMERGENCY SHUTDOWN
// =============================================================
document.getElementById('emergencyBtn').addEventListener('click', () => {
    const pwd = document.getElementById('shutdownPassword').value.trim();
    if (pwd === shutdownPassword) {
        if (confirm('⚠️ آیا از خاموش‌سازی کامل اکوسیستم اطمینان دارید؟')) {
            document.querySelectorAll('.agent-item').forEach(el => el.style.opacity = '0.3');
            document.querySelectorAll('.status-dot').forEach(d => d.className = 'status-dot offline');
            document.getElementById('emergencyBtn').textContent = '⛔ سیستم خاموش شد';
            document.getElementById('emergencyBtn').style.background = 'rgba(248,113,113,0.3)';
            alert('🚨 اکوسیستم به‌طور کامل خاموش شد.');
        }
    } else {
        alert('❌ رمز اشتباه است.');
    }
});

document.getElementById('shutdownConfirmBtn').addEventListener('click', () => {
    document.getElementById('emergencyBtn').click();
});

document.getElementById('emergencyToggle').addEventListener('click', () => {
    document.getElementById('shutdownPassword').focus();
    document.getElementById('sidePanel').classList.remove('closed');
});

// =============================================================
// TOGGLE SIDE PANEL
// =============================================================
let sidePanelOpen = true;
document.getElementById('toggleSidePanel').addEventListener('click', () => {
    sidePanelOpen = !sidePanelOpen;
    document.getElementById('sidePanel').classList.toggle('closed');
    document.getElementById('toggleSidePanel').innerHTML = sidePanelOpen ? '<i class="fas fa-chevron-left"></i>' : '<i class="fas fa-chevron-right"></i>';
});

// =============================================================
// EDIT PANEL (ویرایشگر در صفحه)
// =============================================================
document.getElementById('editPanelBtn').addEventListener('click', () => {
    const editable = document.querySelectorAll('.stat-row .value, #agentList .agent-item, .floating-header .badge-group span');
    editable.forEach(el => {
        if (el.isContentEditable) {
            el.contentEditable = 'false';
            el.style.border = 'none';
        } else {
            el.contentEditable = 'true';
            el.style.border = '1px dashed #4f9eff';
            el.style.borderRadius = '4px';
            el.style.padding = '0 0.2rem';
        }
    });
    alert('✏️ حالت ویرایش فعال شد. روی هر مقدار کلیک کنید و تغییر دهید. پس از اتمام، دوباره دکمه ویرایش را بزنید.');
});

// =============================================================
// REAL-TIME STATS UPDATE (شبیه‌سازی با داده‌های واقعی)
// =============================================================
async function updateStats() {
    try {
        // دریافت تعداد مخازن از GitHub
        const reposRes = await fetch(`https://api.github.com/orgs/${GITHUB_ORG}/repos?per_page=100`);
        if (reposRes.ok) {
            const repos = await reposRes.json();
            document.getElementById('statRepos').textContent = repos.length;
        }
        // شبیه‌سازی داده‌های ولیدیتور (در واقعیت از Core Engine دریافت می‌شود)
        const online = Math.floor(88240 + (Math.random() * 1000 - 500));
        const offline = Math.floor(11760 + (Math.random() * 500 - 250));
        document.getElementById('statOnline').textContent = online.toLocaleString();
        document.getElementById('statOffline').textContent = offline.toLocaleString();
        document.getElementById('statValidators').textContent = (online + offline).toLocaleString();
        document.getElementById('statTx').textContent = Math.floor(12456 + Math.random() * 1000 - 500).toLocaleString();
        document.getElementById('statLicenses').textContent = Math.floor(456 + Math.random() * 20 - 10);
        document.getElementById('activeProductsCount').textContent = Math.floor(12 + Math.random() * 3);
        document.getElementById('nodesCount').textContent = Math.floor(24 + Math.random() * 4);
        document.getElementById('onlineCount').textContent = Math.floor(186 + Math.random() * 10 - 5);
        document.getElementById('statApiCredit').textContent = Math.floor(85 + Math.random() * 15) + '%';
    } catch(e) {
        console.log('⚠️ خطا در دریافت داده‌ها');
    }
}
updateStats();
setInterval(updateStats, 15000);

// =============================================================
// INIT MAP AFTER DOM LOAD
// =============================================================
document.addEventListener('DOMContentLoaded', () => {
    initMap();
    // تنظیم پنل باز
    document.getElementById('sidePanel').classList.remove('closed');
});
</script>
