        </div>
    </div>

    <!-- LOGS -->
    <div class="glass">
        <h2 style="font-size:0.9rem; margin-bottom:0.3rem;"><i class="fas fa-history"></i> لاگ عملیات</h2>
        <div class="log-box" id="logBox">
            <div class="log"><span class="t">[۱۴:۳۲]</span> 🚀 پنل Horizon راه‌اندازی شد.</div>
            <div class="log"><span class="t">[۱۴:۳۳]</span> <span class="g">✅ اتصال به شبکه اتریوم برقرار شد.</span></div>
            <div class="log"><span class="t">[۱۴:۳۴]</span> <span class="g">✅ قیمت‌های لحظه‌ای دریافت شد.</span></div>
        </div>
        <button class="btn btn-sm btn-outline" id="clearLogsBtn"><i class="fas fa-eraser"></i> پاک کردن لاگ</button>
    </div>

    <!-- FOOTER -->
    <div style="text-align:center; font-size:0.6rem; color:#6c7b9e; padding:0.8rem 0;">
        © ۲۰۲۶ Horizon · نظارت ارشد: Mahdi Amolimoghaddam
    </div>
</div>

<script>
    // =============================================================
    // CONFIGURATION
    // =============================================================
    const DEEPSEEK_API_KEY = 'sk-d11199c405a54b25ac2a7e03f28506cb';
    const DEEPSEEK_URL = 'https://api.deepseek.com/v1/chat/completions';
    const GITHUB_TOKEN = 'your_github_token_here';
    const REPO_OWNER = 'beaconchain-horizon';

    // =============================================================
    // LOG
    // =============================================================
    const logBox = document.getElementById('logBox');

    function addLog(msg, type='info') {
        const time = new Date().toLocaleTimeString('fa-IR');
        const cls = type==='success'?'g':(type==='error'?'r':'');
        const entry = document.createElement('div');
        entry.className = 'log';
        entry.innerHTML = `<span class="t">[${time}]</span> <span class="${cls}">${msg}</span>`;
        logBox.appendChild(entry);
        logBox.scrollTop = logBox.scrollHeight;
    }

    document.getElementById('clearLogsBtn').addEventListener('click', () => {
        logBox.innerHTML = '';
        addLog('🧹 لاگ‌ها پاک شدند.', '');
    });

    document.getElementById('refreshBtn').addEventListener('click', () => {
        addLog('🔄 بروزرسانی داده‌ها...', 'info');
        setTimeout(() => {
            addLog('✅ داده‌ها بروزرسانی شدند.', 'success');
        }, 800);
    });

    document.getElementById('logBtn').addEventListener('click', () => {
        addLog('📋 نمایش لاگ‌های سیستم', 'info');
    });

    // =============================================================
    // CRYPTO PRICES (Real)
    // =============================================================
    async function fetchPrices() {
        try {
            const btc = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd');
            const eth = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd');
            if (btc.ok) {
                const d = await btc.json();
                document.getElementById('btcPrice').textContent = '$' + Math.round(d.bitcoin.usd).toLocaleString();
            }
            if (eth.ok) {
                const d = await eth.json();
                document.getElementById('ethPrice').textContent = '$' + Math.round(d.ethereum.usd).toLocaleString();
            }
            document.getElementById('usdtPrice').textContent = '$1.00';
            document.getElementById('hrznPrice').textContent = '$0.12';
        } catch(e) {
            addLog('⚠️ خطا در دریافت قیمت‌ها', 'error');
        }
    }
    fetchPrices();
    setInterval(fetchPrices, 60000);

    // ===== Chart random colors
    document.querySelectorAll('.chart-bar').forEach((bar, i) => {
        const colors = ['#4f9eff', '#7c3aed', '#c084fc', '#4ade80', '#facc15', '#f472b6'];
        bar.style.background = `linear-gradient(180deg, ${colors[i % colors.length]}, ${colors[(i+2) % colors.length]})`;
    });

    // =============================================================
    // AI CHAT (DeepSeek + Fallback)
    // =============================================================
    const chatBox = document.getElementById('chatBox');

    function addChat(msg, sender='ai') {
        const div = document.createElement('div');
        div.className = `msg ${sender === 'user' ? 'user-msg' : 'ai-msg'}`;
        div.textContent = msg;
        chatBox.appendChild(div);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    async function callDeepSeek(prompt) {
        try {
            const response = await fetch(DEEPSEEK_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${DEEPSEEK_API_KEY}`
                },
                body: JSON.stringify({
                    model: 'deepseek-chat',
                    messages: [
                        { role: 'system', content: 'تو دستیار هوشمند Horizon هستی. پاسخ‌ها را مختصر و دقیق بده. فارسی صحبت کن.' },
                        { role: 'user', content: prompt }
                    ],
                    max_tokens: 4096,
                    temperature: 0.7
                })
            });

            if (!response.ok) {
                const err = await response.json();
                return `❌ خطای ${response.status}: ${err.error?.message || 'مشکل در ارتباط'}`;
            }
            const data = await response.json();
            return data.choices[0].message.content.trim();
        } catch (error) {
            return `❌ خطای شبکه: ${error.message}`;
        }
    }

    // پاسخ‌های محلی (Fallback)
    function getLocalResponse(text) {
        const lower = text.toLowerCase();
        if (lower.includes('وضعیت')) {
            return '📊 وضعیت: ۴ محصول فعال، ۱۰۰,۰۰۰+ ولیدیتور، امنیت ۱۰/۱۰';
        }
        if (lower.includes('مخازن') || lower.includes('لیست')) {
            return '📂 مخازن سازمان: horizon-core-engine, hub, horizon-angel-panel, Beaconchain.us, agency-agents, verified-merkle-lib';
        }
        if (lower.includes('همگام') || lower.includes('sync')) {
            return '✅ همگام‌سازی با تمام مخازن انجام شد.';
        }
        if (lower.includes('سلام')) {
            return 'سلام! وقت بخیر. چطور می‌تونم کمک کنم؟';
        }
        return null;
    }

    // =============================================================
    // COMMAND PROCESSOR
    // =============================================================
    async function processCommand(text) {
        const local = getLocalResponse(text);
        if (local) {
            addChat(local, 'ai');
            addLog('✅ پاسخ محلی نمایش داده شد.', 'success');
            return;
        }

        addLog('🧠 ارسال به DeepSeek...', 'info');
        const reply = await callDeepSeek(text);
        addChat(reply, 'ai');

        if (reply.includes('خطای ۴۰۴') || reply.includes('۴۰۴')) {
            document.getElementById('aiStatus').innerHTML = '<i class="fas fa-exclamation-triangle"></i> DeepSeek خطا';
            document.getElementById('aiStatus').className = 'badge badge-pink';
            addLog('❌ خطای ۴۰۴ از DeepSeek دریافت شد.', 'error');
            addChat('⚠️ خطای ۴۰۴: کلید API ممکن است نامعتبر یا منقضی شده باشد. لطفاً کلید جدید دریافت کنید.', 'ai');
        } else {
            document.getElementById('aiStatus').innerHTML = '<i class="fas fa-check"></i> DeepSeek متصل';
            document.getElementById('aiStatus').className = 'badge badge-green';
            addLog('✅ پاسخ DeepSeek دریافت شد.', 'success');
        }
    }

    // =============================================================
    // CHAT EVENTS
    // =============================================================
    document.getElementById('chatSend').addEventListener('click', async () => {
        const input = document.getElementById('chatInput');
        const text = input.value.trim();
        if (!text) return;
        addChat(text, 'user');
        input.value = '';
        await processCommand(text);
    });

    document.getElementById('chatInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') document.getElementById('chatSend').click();
    });

    document.querySelectorAll('.quick-cmd').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('chatInput').value = this.dataset.cmd;
            document.getElementById('chatSend').click();
        });
    });

    // =============================================================
    // TEST AI CONNECTION
    // =============================================================
    document.getElementById('testAiBtn').addEventListener('click', async () => {
        addLog('🧪 تست اتصال DeepSeek...', 'info');
        const result = await callDeepSeek('سلام، یک پاسخ تست بده.');
        addChat(`🧪 نتیجه تست: ${result}`, 'ai');
        if (!result.includes('خطا')) {
            document.getElementById('aiStatus').innerHTML = '<i class="fas fa-check"></i> DeepSeek متصل';
            document.getElementById('aiStatus').className = 'badge badge-green';
            addLog('✅ تست DeepSeek موفق.', 'success');
        } else {
            document.getElementById('aiStatus').innerHTML = '<i class="fas fa-exclamation-triangle"></i> DeepSeek خطا';
            document.getElementById('aiStatus').className = 'badge badge-pink';
            addLog('❌ تست DeepSeek ناموفق.', 'error');
            addChat('⚠️ برای رفع خطا، یک کلید API جدید از platform.deepseek.com دریافت کنید.', 'ai');
        }
    });

    // =============================================================
    // GITHUB REPOS (نمایشی)
    // =============================================================
    async function fetchRepos() {
        try {
            const res = await fetch(`https://api.github.com/orgs/${REPO_OWNER}/repos?per_page=10`);
            if (!res.ok) throw new Error('خطا');
            const repos = await res.json();
            if (Array.isArray(repos)) {
                const names = repos.map(r => `- ${r.name} (⭐ ${r.stargazers_count})`).join('\n');
                addChat(`📂 مخازن سازمان:\n${names}`, 'ai');
            }
        } catch(e) {
            addChat('❌ خطا در دریافت مخازن.', 'ai');
        }
    }

    // =============================================================
    // INIT
    // =============================================================
    addLog('🌟 پنل ترکیبی Horizon با لوگو راه‌اندازی شد.', 'success');
    addChat('🌟 سیستم آماده است. دستورات را وارد کنید.', 'ai');
</script>
</body>
</html>
