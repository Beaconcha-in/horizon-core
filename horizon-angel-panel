<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>افق · پنل ترکیبی کریپتو و مدیریت</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family:'Inter', sans-serif;
            min-height:100vh;
            background: #0a0f1e;
            overflow-x:hidden;
            position:relative;
            color:#eef2ff;
            padding:0.8rem;
        }
        .crypto-bg {
            position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            z-index:0;
            pointer-events:none;
            overflow:hidden;
            background: radial-gradient(circle at 20% 30%, #0f1a3a, #05080f);
        }
        .crypto-bg .symbol {
            position:absolute;
            font-weight:900;
            opacity:0.04;
            font-size:12rem;
            user-select:none;
            animation: floatSymbol 20s ease-in-out infinite alternate;
            color:#fff;
        }
        .crypto-bg .symbol:nth-child(1) { top:5%; left:5%; font-size:18rem; animation-duration:25s; color:#f7931a; opacity:0.05; }
        .crypto-bg .symbol:nth-child(2) { bottom:10%; right:5%; font-size:16rem; animation-duration:22s; color:#627eea; opacity:0.06; }
        .crypto-bg .symbol:nth-child(3) { top:40%; left:50%; font-size:14rem; animation-duration:28s; color:#26a17b; opacity:0.04; transform:translateX(-50%); }
        .crypto-bg .symbol:nth-child(4) { top:70%; left:10%; font-size:10rem; animation-duration:18s; color:#f7931a; opacity:0.04; }
        .crypto-bg .symbol:nth-child(5) { bottom:30%; right:20%; font-size:12rem; animation-duration:30s; color:#627eea; opacity:0.05; }
        .crypto-bg .symbol:nth-child(6) { top:15%; right:15%; font-size:9rem; animation-duration:20s; color:#26a17b; opacity:0.04; }
        @keyframes floatSymbol {
            0% { transform: translate(0,0) scale(1) rotate(0deg); }
            25% { transform: translate(20px,-30px) scale(1.05) rotate(5deg); }
            50% { transform: translate(-20px,20px) scale(0.95) rotate(-3deg); }
            75% { transform: translate(30px,10px) scale(1.02) rotate(4deg); }
            100% { transform: translate(-10px,-20px) scale(0.98) rotate(-2deg); }
        }
        .crypto-bg .line {
            position:absolute;
            background:linear-gradient(90deg, transparent, rgba(79,158,255,0.06), transparent);
            height:1px;
            width:100%;
            animation: scanLine 10s linear infinite;
        }
        .crypto-bg .line:nth-child(7) { top:20%; animation-duration:12s; }
        .crypto-bg .line:nth-child(8) { top:50%; animation-duration:8s; opacity:0.5; }
        .crypto-bg .line:nth-child(9) { top:80%; animation-duration:15s; }
        @keyframes scanLine {
            0% { transform:translateX(-100%); }
            100% { transform:translateX(100%); }
        }

        .main-content {
            position:relative;
            z-index:1;
            max-width:1440px;
            margin:0 auto;
        }
        .glass {
            background:rgba(10,15,30,0.75);
            backdrop-filter:blur(16px);
            border-radius:2rem;
            border:1px solid rgba(79,158,255,0.15);
            padding:1.2rem 1.5rem;
            margin-bottom:1.2rem;
            transition:0.3s;
        }
        .glass:hover { border-color:rgba(79,158,255,0.3); }
        .flex { display:flex; flex-wrap:wrap; gap:0.8rem; align-items:center; justify-content:space-between; }
        .badge {
            background:rgba(79,158,255,0.12);
            border:1px solid #4f9eff33;
            padding:0.15rem 0.8rem;
            border-radius:60px;
            font-size:0.6rem;
            display:inline-block;
            color:#9bb2ff;
        }
        .badge-green { background:rgba(74,222,128,0.12); border-color:#4ade8044; color:#4ade80; }
        .badge-gold { background:rgba(251,191,36,0.12); border-color:#facc1544; color:#facc15; }
        .badge-purple { background:rgba(192,132,252,0.12); border-color:#c084fc44; color:#c084fc; }
        .badge-pink { background:rgba(244,114,182,0.12); border-color:#f472b644; color:#f472b6; }
        .btn {
            background:linear-gradient(135deg, #4f9eff, #7c3aed);
            border:none;
            padding:0.4rem 1.4rem;
            border-radius:2rem;
            font-weight:600;
            color:#fff;
            cursor:pointer;
            transition:0.3s;
            font-size:0.75rem;
        }
        .btn:hover { transform:scale(1.04); box-shadow:0 8px 30px rgba(79,158,255,0.3); }
        .btn-outline { background:transparent; border:1px solid #4f9eff55; color:#eef2ff; }
        .btn-outline:hover { background:#4f9eff22; }
        .btn-sm { font-size:0.65rem; padding:0.25rem 1rem; }
        .grid-4 {
            display:grid;
            grid-template-columns:repeat(auto-fit, minmax(140px,1fr));
            gap:0.8rem;
        }
        .stat-card {
            background:rgba(20,24,36,0.5);
            border-radius:1rem;
            padding:0.6rem 1rem;
            border:1px solid rgba(255,255,255,0.04);
            text-align:center;
            backdrop-filter:blur(8px);
        }
        .stat-card .num { font-size:1.5rem; font-weight:800; color:#4f9eff; }
        .stat-card .label { font-size:0.55rem; color:#8fa2dc; }
        .grid-crypto {
            display:grid;
            grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
            gap:1rem;
        }
        .crypto-card {
            background:rgba(20,24,36,0.5);
            border-radius:1.2rem;
            padding:0.8rem 1rem;
            border:1px solid rgba(255,255,255,0.05);
            text-align:center;
            transition:0.3s;
        }
        .crypto-card:hover { border-color:#4f9eff; transform:translateY(-3px); }
        .crypto-card .icon { font-size:2.2rem; }
        .crypto-card .name { font-weight:700; font-size:0.9rem; margin:0.2rem 0; }
        .crypto-card .price { font-size:1.1rem; font-weight:700; color:#4f9eff; }
        .crypto-card .change { font-size:0.7rem; font-weight:600; }
        .crypto-card .change.up { color:#4ade80; }
        .crypto-card .change.down { color:#f87171; }
        .chart-placeholder {
            background:rgba(20,24,36,0.3);
            border-radius:1rem;
            height:120px;
            display:flex;
            align-items:flex-end;
            justify-content:space-around;
            padding:0.5rem;
            gap:0.3rem;
            margin-top:0.5rem;
        }
        .chart-bar {
            width:100%;
            background:linear-gradient(180deg, #4f9eff, #7c3aed);
            border-radius:4px 4px 0 0;
            transition:0.3s;
            min-height:10px;
            opacity:0.7;
        }
        .chart-bar:hover { opacity:1; transform:scaleY(1.02); }
        .chat-box {
            background:rgba(15,23,42,0.6);
            border-radius:1rem;
            padding:0.5rem 0.8rem;
            max-height:160px;
            overflow-y:auto;
            border:1px solid #1e2a44;
            display:flex;
            flex-direction:column;
            gap:0.2rem;
        }
        .chat-box .msg { padding:0.2rem 0.7rem; border-radius:0.8rem; max-width:90%; font-size:0.75rem; line-height:1.4; }
        .chat-box .user-msg { align-self:flex-end; background:#4f9eff; color:#0a0f1e; }
        .chat-box .ai-msg { align-self:flex-start; background:rgba(255,255,255,0.06); color:#e5e7f0; border:1px solid #2a3a5a; }
        .chat-input-row { display:flex; gap:0.4rem; margin-top:0.4rem; }
        .chat-input-row input { flex:1; background:#0f172a; border:1px solid #2a3a5a; border-radius:2rem; padding:0.3rem 0.8rem; color:#eef2ff; outline:none; font-size:0.75rem; }
        .chat-input-row input:focus { border-color:#4f9eff; }
        .chat-input-row button { background:#4f9eff; border:none; border-radius:2rem; padding:0 1rem; font-weight:600; color:#0a0f1e; cursor:pointer; font-size:0.7rem; }
        .log-box {
            background:rgba(15,23,42,0.6);
            border-radius:1rem;
            padding:0.4rem 0.8rem;
            max-height:120px;
            overflow-y:auto;
            font-family:monospace;
            font-size:0.6rem;
            border:1px solid #1e2a44;
        }
        .log-box .log { padding:0.1rem 0; border-bottom:1px solid #1a2238; color:#94a3b8; }
        .log-box .log .t { color:#4f9eff; margin-left:0.3rem; }
        .log-box .log .g { color:#4ade80; }
        .log-box .log .r { color:#f87171; }

        .grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; }
        .logo-svg { width:180px; height:auto; flex-shrink:0; }
        @media (max-width:700px) { .grid-2 { grid-template-columns:1fr; } .logo-svg { width:120px; } }
        @media (max-width:640px) {
            .main-content { padding:0.4rem; }
            .glass { padding:0.8rem; }
            .crypto-bg .symbol { font-size:6rem !important; }
            .logo-svg { width:100px; }
        }
    </style>
</head>
<body>

<!-- ===== پس‌زمینه ===== -->
<div class="crypto-bg">
    <div class="symbol">₿</div>
    <div class="symbol">⟠</div>
    <div class="symbol">₮</div>
    <div class="symbol">₿</div>
    <div class="symbol">⟠</div>
    <div class="symbol">₮</div>
    <div class="line"></div>
    <div class="line"></div>
    <div class="line"></div>
</div>

<!-- ===== محتوای اصلی ===== -->
<div class="main-content">

    <!-- HEADER با لوگو -->
    <div class="glass">
        <div class="flex">
            <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
                <!-- لوگو -->
                <div class="logo-svg">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 120" width="100%" height="auto">
                      <defs>
                        <linearGradient id="beaconGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" style="stop-color:#00D4FF;stop-opacity:1" />
                          <stop offset="50%" style="stop-color:#7B61FF;stop-opacity:1" />
                          <stop offset="100%" style="stop-color:#FF6B9D;stop-opacity:1" />
                        </linearGradient>
                        <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                          <stop offset="0%" style="stop-color:#0B0F1C;stop-opacity:1" />
                          <stop offset="100%" style="stop-color:#1A1F35;stop-opacity:1" />
                        </linearGradient>
                        <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                          <feGaussianBlur stdDeviation="3" result="blur" />
                          <feComposite in="SourceGraphic" in2="blur" operator="over" />
                        </filter>
                      </defs>
                      <rect width="400" height="120" rx="16" fill="url(#bgGradient)" />
                      <circle cx="55" cy="60" r="28" fill="none" stroke="url(#beaconGlow)" stroke-width="2.5" opacity="0.3" />
                      <circle cx="55" cy="60" r="20" fill="none" stroke="url(#beaconGlow)" stroke-width="2.5" opacity="0.5" />
                      <circle cx="55" cy="60" r="12" fill="none" stroke="url(#beaconGlow)" stroke-width="3" />
                      <circle cx="55" cy="60" r="5" fill="#00D4FF" filter="url(#glow)" />
                      <line x1="75" y1="45" x2="115" y2="45" stroke="url(#beaconGlow)" stroke-width="2" opacity="0.6" stroke-linecap="round" />
                      <line x1="75" y1="60" x2="120" y2="60" stroke="url(#beaconGlow)" stroke-width="3" opacity="0.8" stroke-linecap="round" />
                      <line x1="75" y1="75" x2="110" y2="75" stroke="url(#beaconGlow)" stroke-width="2" opacity="0.6" stroke-linecap="round" />
                      <polygon points="90,45 93,38 96,45" fill="#7B61FF" opacity="0.7" />
                      <polygon points="105,60 108,53 111,60" fill="#FF6B9D" opacity="0.7" />
                      <text x="140" y="55" font-family="'Segoe UI', Helvetica, Arial, sans-serif" font-size="22" font-weight="700" fill="#FFFFFF" letter-spacing="1.5">
                        BEACONCHAIN
                        <tspan x="140" dy="28" font-family="'Segoe UI', Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="url(#beaconGlow)" letter-spacing="3" opacity="0.9">
                          HORIZON
                        </tspan>
                      </text>
                      <line x1="140" y1="88" x2="330" y2="88" stroke="url(#beaconGlow)" stroke-width="1.5" opacity="0.4" stroke-linecap="round" />
                      <text x="140" y="105" font-family="'Segoe UI', Helvetica, Arial, sans-serif" font-size="9" fill="#8892B0" letter-spacing="1.2" font-weight="300">
                        DECENTRALIZED ECOSYSTEM
                      </text>
                    </svg>
                </div>
                <div>
                    <h1 style="font-size:1.6rem; background:linear-gradient(135deg,#fff,#4f9eff,#c084fc); -webkit-background-clip:text; background-clip:text; color:transparent;">
                        <i class="fas fa-robot"></i> Horizon · پنل ترکیبی
                    </h1>
                    <div style="display:flex; gap:0.3rem; flex-wrap:wrap; margin-top:0.2rem;">
                        <span class="badge"><i class="fas fa-shield-alt"></i> Horizon Angel</span>
                        <span class="badge badge-green"><i class="fas fa-circle"></i> متصل</span>
                        <span class="badge badge-gold"><i class="fas fa-user-tie"></i> Mahdi Amolimoghaddam</span>
                        <span class="badge badge-purple"><i class="fas fa-database"></i> Core Engine</span>
                        <span class="badge badge-pink"><i class="fas fa-coins"></i> BTC · ETH · USDT</span>
                    </div>
                </div>
            </div>
            <div>
                <button class="btn" id="refreshBtn"><i class="fas fa-sync-alt"></i> بروز</button>
                <button class="btn btn-outline" id="logBtn"><i class="fas fa-history"></i> لاگ</button>
            </div>
        </div>
    </div>

    <!-- STATS -->
    <div class="glass">
        <div class="grid-4">
            <div class="stat-card"><div class="num" id="totalTx">۱۲,۴۵۶</div><div class="label">تراکنش‌ها</div></div>
            <div class="stat-card"><div class="num" id="activeValidators">۱۰۰K+</div><div class="label">ولیدیتور فعال</div></div>
            <div class="stat-card"><div class="num" id="licensesIssued">۴۵۶</div><div class="label">لایسنس صادرشده</div></div>
            <div class="stat-card"><div class="num" id="securityScore">۱۰/۱۰</div><div class="label">امتیاز امنیت</div></div>
        </div>
    </div>

    <!-- CRYPTO PRICES -->
    <div class="glass">
        <h2 style="font-size:1rem; margin-bottom:0.5rem;"><i class="fas fa-chart-line"></i> قیمت‌های لحظه‌ای</h2>
        <div class="grid-crypto" id="cryptoGrid">
            <div class="crypto-card">
                <div class="icon">₿</div>
                <div class="name">Bitcoin</div>
                <div class="price" id="btcPrice">$۶۲,۴۵۰</div>
                <div class="change up">▲ +۲.۴%</div>
            </div>
            <div class="crypto-card">
                <div class="icon" style="color:#627eea;">⟠</div>
                <div class="name">Ethereum</div>
                <div class="price" id="ethPrice">$۳,۴۲۰</div>
                <div class="change up">▲ +۱.۸%</div>
            </div>
            <div class="crypto-card">
                <div class="icon" style="color:#26a17b;">₮</div>
                <div class="name">Tether</div>
                <div class="price" id="usdtPrice">$۱.۰۰</div>
                <div class="change" style="color:#8fa2dc;">— ۰.۰%</div>
            </div>
            <div class="crypto-card">
                <div class="icon" style="color:#f7931a;">₿</div>
                <div class="name">Horizon (HRZN)</div>
                <div class="price" id="hrznPrice">$۰.۱۲</div>
                <div class="change up">▲ +۵.۲%</div>
            </div>
        </div>
    </div>

    <!-- CHART + VALIDATORS -->
    <div class="grid-2">
        <div class="glass">
            <h2 style="font-size:0.9rem; margin-bottom:0.3rem;"><i class="fas fa-chart-bar"></i> حجم تراکنش‌ها (۲۴ ساعت)</h2>
            <div class="chart-placeholder" id="chartContainer">
                <div class="chart-bar" style="height:30%;"></div>
                <div class="chart-bar" style="height:60%;"></div>
                <div class="chart-bar" style="height:45%;"></div>
                <div class="chart-bar" style="height:85%;"></div>
                <div class="chart-bar" style="height:70%;"></div>
                <div class="chart-bar" style="height:95%;"></div>
                <div class="chart-bar" style="height:50%;"></div>
                <div class="chart-bar" style="height:75%;"></div>
                <div class="chart-bar" style="height:40%;"></div>
                <div class="chart-bar" style="height:65%;"></div>
                <div class="chart-bar" style="height:90%;"></div>
                <div class="chart-bar" style="height:55%;"></div>
            </div>
        </div>
        <div class="glass">
            <h2 style="font-size:0.9rem; margin-bottom:0.3rem;"><i class="fas fa-shield-alt"></i> ولیدیتورهای آنلاین</h2>
            <div style="display:flex; gap:1rem; flex-wrap:wrap; font-size:0.8rem;">
                <span class="badge badge-green">🟢 ۸۸,۲۴۰ آنلاین</span>
                <span class="badge" style="color:#f87171; border-color:#f8717144;">🔴 ۱۱,۷۶۰ آفلاین</span>
                <span class="badge badge-gold">🟡 ۲,۱۳۴ در انتظار</span>
            </div>
            <div style="margin-top:0.5rem; display:flex; flex-wrap:wrap; gap:0.2rem;">
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#f87171;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#facc15;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#f87171;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
