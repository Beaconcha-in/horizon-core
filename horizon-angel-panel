        </div>
        <div style="display:flex; gap:0.3rem; flex-wrap:wrap; margin-top:0.3rem;">
            <button class="btn btn-sm btn-outline quick-cmd" data-cmd="وضعیت"><i class="fas fa-chart-simple"></i> وضعیت</button>
