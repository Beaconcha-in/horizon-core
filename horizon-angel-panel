                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#f87171;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#4ade80;"></span>
            </div>
        </div>
    </div>

    <!-- AI COMMAND CENTER -->
    <div class="glass">
        <h2 style="font-size:1rem; margin-bottom:0.3rem;"><i class="fas fa-comment-dots"></i> مرکز فرماندهی هوش مصنوعی</h2>
        <div style="display:flex; gap:0.3rem; flex-wrap:wrap; margin-bottom:0.3rem;">
            <span class="badge badge-green" id="aiStatus"><i class="fas fa-check"></i> DeepSeek متصل</span>
            <button class="btn btn-sm btn-outline" id="testAiBtn"><i class="fas fa-vial"></i> تست اتصال</button>
        </div>
