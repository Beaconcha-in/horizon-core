// ============================================================
// Integration Manager
// ============================================================
type IntegrationManager struct {
	clients map[string]ExplorerClient
}

func NewIntegrationManager() *IntegrationManager {
	return &IntegrationManager{
		clients: make(map[string]ExplorerClient),
	}
}

func (m *IntegrationManager) RegisterClient(name string, client ExplorerClient) {
	m.clients[name] = client
}

func (m *IntegrationManager) GetClient(name string) ExplorerClient {
	return m.clients[name]
}

func (m *IntegrationManager) GetAllNetworks() []string {
	networks := make([]string, 0, len(m.clients))
	for name := range m.clients {
		networks = append(networks, name)
	}
	return networks
}

// GetBalanceFromAllNetworks gets balance from all networks concurrently
func (m *IntegrationManager) GetBalanceFromAllNetworks(address string) map[string]float64 {
	results := make(map[string]float64)
	var mu sync.Mutex
	var wg sync.WaitGroup

	for name, client := range m.clients {
		wg.Add(1)
		go func(n string, c ExplorerClient) {
			defer wg.Done()
			balance, err := c.GetBalance(address)
			if err == nil {
				mu.Lock()
				results[n] = balance
				mu.Unlock()
			}
		}(name, client)
	}
	wg.Wait()
	return results
}
